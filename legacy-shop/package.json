{
  "name": "legacy-shop",
  "version": "0.4.2",
  "private": true,
  "description": "Catalogo de productos con carrito — tienda interna",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "start": "node server/src/index.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "setup:agents": "node -e \"if(process.platform==='win32'){require('child_process').execSync('powershell -ExecutionPolicy Bypass -File sdd/scripts/setup-agents.ps1',{stdio:'inherit'})}else{require('child_process').execSync('bash sdd/scripts/setup-agents.sh',{stdio:'inherit'})}\"",
    "sdd:docs": "node sdd/docs/serve.mjs",
    "sdd:validate": "node sdd/scripts/validate-sdd.mjs",
    "sdd:rebuild-tasks-index": "node sdd/scripts/rebuild-tasks-index.mjs",
    "sdd:rebuild-catalog": "node sdd/scripts/rebuild-catalog.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
