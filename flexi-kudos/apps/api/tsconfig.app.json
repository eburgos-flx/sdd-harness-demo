{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": [
      "node"
    ],
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "exclude": [
    "jest.config.js",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "prisma/seed.ts"
  ],
  "include": ["src/**/*.ts"]
}